<?xml version="1.0" encoding="UTF-8"?>
<!--
    Suíte do pacote twstec/kit-auth, isolada do aplicativo: sobe uma
    aplicação Laravel mínima (Orchestra Testbench) só com os providers do
    pacote. Os testes que dependem de rotas e telas do aplicativo continuam na
    suíte do starter.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Protections">
            <directory>tests/Protections</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <!-- force + server: o container de desenvolvimento injeta o .env do
         starter no ambiente, e o Laravel lê $_SERVER primeiro. -->
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Idioma de uma aplicação Laravel limpa, fixado: o container de
             desenvolvimento injeta o APP_LOCALE do starter, e o CI não tem
             nenhum. Os testes que dependem do idioma o escolhem sozinhos. -->
        <env name="APP_LOCALE" value="en" force="true"/>
        <server name="APP_LOCALE" value="en" force="true"/>
        <env name="APP_FALLBACK_LOCALE" value="en" force="true"/>
        <server name="APP_FALLBACK_LOCALE" value="en" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="testing" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
    </php>
</phpunit>
